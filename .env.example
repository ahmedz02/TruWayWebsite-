# Email Configuration — Google Workspace SMTP
# Copy this file to .env.local for local dev
# For production, add these as Environment Variables in Netlify dashboard

# Google Workspace SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@tru-way.com
SMTP_PASSWORD=your_google_workspace_app_password_here
SMTP_FROM=info@tru-way.com

# Google Analytics 4
# Get this from analytics.google.com after creating a GA4 property
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification
# Get this from search.google.com/search-console after adding your property
NEXT_PUBLIC_GSC_VERIFICATION=your_verification_code_here
